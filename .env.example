# Copy to .env. Keep .env private and out of Git.
# Run php tools/setup-admin.php to create password hashes interactively.
# Comma-separated usernames: letters, digits, underscores; start with a letter.
ADMIN_USERNAMES=editor,parent
ADMIN_EDITOR_PASSWORD_HASH=
ADMIN_PARENT_PASSWORD_HASH=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
